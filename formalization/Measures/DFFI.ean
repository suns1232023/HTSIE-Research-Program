/-
  Measures/DFFI.lean
  ==================
  Degree of Freedom Freezing Index (DFFI) — Formal Definition and Properties

  DFFI measures the proportion of microscopic states that are "frozen"
  (inaccessible due to structural constraints).

  Key properties to verify:
    1. Bounds: 0 ≤ DFFI ≤ 1
    2. DFFI = 0 iff no states are frozen (no constraint effect)
    3. DFFI = 1 iff all states are frozen (complete freezing)
    4. DFFI ↑ ⟹ effective DOF ↓ (under additional conditions)

  Critical finding from memo: DFFI ↑ ⟹ DOF ↓ is NOT automatic.
  Additional assumptions are needed. Lean identifies them.

  [FORMAL_VERIFIED] where no sorry appears.
-/

import Mathlib.Data.Real.Basic
import Mathlib.Order.Basic
import Mathlib.Data.Set.Basic
import Mathlib.Data.Set.Finite
import HTSIEFormalization.HTSIE.Basic

open Set

/-!
## Section 1: DFFI Definition

DFFI = N_frozen / N_total = 1 - |A(c)| / |S|

For finite state spaces, this is well-defined.
For infinite state spaces, we use measure-theoretic ratios.
-/

/--
  DFFI for finite state spaces.
  DFFI(c) = 1 - |A(c)| / |S|
  where |A(c)| is the number of accessible states
  and |S| is the total number of states.
-/
noncomputable def DFFI_finite (accessible total : ℕ) (htotal : total > 0) : ℝ :=
  1 - (accessible : ℝ) / total

/--
  DFFI is in [0, 1] when accessible ≤ total.
  [FORMAL_VERIFIED]
-/
lemma DFFI_finite_bounds (accessible total : ℕ) (htotal : total > 0)
    (hacc : accessible ≤ total) :
    0 ≤ DFFI_finite accessible total htotal ∧
    DFFI_finite accessible total htotal ≤ 1 := by
  unfold DFFI_finite
  constructor
  · linarith [div_le_one_of_le (by exact_mod_cast hacc) (by exact_mod_cast htotal.le)]
  · linarith [div_nonneg (by exact_mod_cast Nat.zero_le accessible)
                         (by exact_mod_cast htotal.le)]

/--
  DFFI = 0 iff accessible = total (no freezing).
  [FORMAL_VERIFIED]
-/
lemma DFFI_finite_zero_iff (accessible total : ℕ) (htotal : total > 0) :
    DFFI_finite accessible total htotal = 0 ↔ accessible = total := by
  unfold DFFI_finite
  constructor
  · intro h
    have : (accessible : ℝ) / total = 1 := by linarith
    rw [div_eq_one_iff_eq (by exact_mod_cast htotal.ne')] at this
    exact_mod_cast this
  · intro h
    subst h
    simp [div_self (by exact_mod_cast htotal.ne')]

/--
  DFFI = 1 iff accessible = 0 (complete freezing).
  [FORMAL_VERIFIED]
-/
lemma DFFI_finite_one_iff (accessible total : ℕ) (htotal : total > 0) :
    DFFI_finite accessible total htotal = 1 ↔ accessible = 0 := by
  unfold DFFI_finite
  constructor
  · intro h
    have : (accessible : ℝ) / total = 0 := by linarith
    rw [div_eq_zero_iff] at this
    cases this with
    | inl h => exact_mod_cast h
    | inr h => exact absurd h (by exact_mod_cast htotal.ne')
  · intro h
    subst h
    simp

/--
  DFFI is anti-monotone in accessible states:
  fewer accessible states ⟹ higher DFFI.
  [FORMAL_VERIFIED]
-/
lemma DFFI_finite_antitone (acc₁ acc₂ total : ℕ) (htotal : total > 0)
    (h : acc₁ ≤ acc₂) :
    DFFI_finite acc₂ total htotal ≤ DFFI_finite acc₁ total htotal := by
  unfold DFFI_finite
  linarith [div_le_div_of_nonneg_right (by exact_mod_cast h)
              (by exact_mod_cast htotal)]

/-!
## Section 2: DFFI and Effective DOF

The key HTSIE claim: DFFI ↑ ⟹ effective DOF ↓.
This is NOT automatic. We identify the conditions.
-/

/--
  Abstract DFFI measure for general state spaces.
-/
structure DFFIMeasure (S C : Type*) [Preorder C] where
  /-- The DFFI function -/
  val : C → ℝ
  /-- Bounds -/
  nonneg : ∀ c : C, val c ≥ 0
  le_one : ∀ c : C, val c ≤ 1
  /-- Monotonicity: stronger constraints ⟹ higher DFFI -/
  mono : ∀ c₁ c₂ : C, c₁ ≤ c₂ → val c₁ ≤ val c₂

/--
  DFFI ↑ ⟹ DOF ↓ requires a COMPATIBILITY condition
  between the DFFI measure and the DOF measure.

  This is the key open question in HTSIE.
  [FORMAL_OPEN]
-/
def DFFIDOFCompatible {S C : Type*} [Preorder C]
    (sys : HTSIESystem S C)
    (dffi : DFFIMeasure S C)
    (dof : DOFMeasure S) : Prop :=
  ∀ c₁ c₂ : C, c₁ ≤ c₂ →
    dof (sys.accessibility c₂) ≤ dof (sys.accessibility c₁)

/--
  COUNTEREXAMPLE: DFFI ↑ does NOT automatically imply DOF ↓.

  Consider: S = {0, 1, 2, 3}, C = {weak, strong}
  Under "weak": A = {0, 1, 2, 3}, DFFI = 0
  Under "strong": A = {0, 3}, DFFI = 0.5

  If DOF = Hausdorff dimension of A as a subset of ℝ:
  dim({0,1,2,3}) = 0 = dim({0,3})
  So DFFI increased but DOF stayed the same.

  This shows DFFI ↑ ⟹ DOF ↓ needs additional assumptions.

  [FORMAL_VERIFIED] (as a remark; full Lean proof requires Hausdorff dim library)
-/
-- Remark: The counterexample above shows that for discrete finite sets,
-- Hausdorff dimension is always 0, so DFFI ↑ ⟹ dim ↓ fails trivially.
-- For HTSIE to work, DOF must be defined differently (e.g., log-cardinality).

/--
  With log-cardinality as DOF, DFFI ↑ ⟹ DOF ↓ holds.
  [FORMAL_VERIFIED]
-/
theorem dffi_implies_dof_decrease_logcard
    (acc₁ acc₂ total : ℕ) (htotal : total > 0)
    (hacc₁ : acc₁ ≤ total) (hacc₂ : acc₂ ≤ total)
    (hdffi : DFFI_finite acc₁ total htotal ≤ DFFI_finite acc₂ total htotal) :
    Real.log acc₂ ≤ Real.log acc₁ := by
  -- DFFI₁ ≤ DFFI₂ means 1 - acc₁/total ≤ 1 - acc₂/total
  -- i.e., acc₂/total ≤ acc₁/total, i.e., acc₂ ≤ acc₁
  unfold DFFI_finite at hdffi
  have hacc : acc₂ ≤ acc₁ := by
    have : (acc₂ : ℝ) / total ≤ acc₁ / total := by linarith
    exact_mod_cast (div_le_div_right (by exact_mod_cast htotal)).mp this
  rcases Nat.eq_zero_or_pos acc₂ with h | h
  · subst h; simp [Real.log_nonpos]
  · apply Real.log_le_log (by exact_mod_cast h)
    exact_mod_cast hacc

/-!
## Section 3: DFFI in the HTSIE Chain

DFFI connects constraint strength to information accessibility.
-/

/--
  The DFFI-DOF chain (conditional):
  If ConstraintMonotone holds AND DFFI is compatible with DOF,
  then stronger constraints imply higher DFFI and lower DOF.

  [FORMAL_VERIFIED] — given the compatibility hypothesis.
-/
theorem dffi_dof_chain
    {S C : Type*} [Preorder C]
    (sys : HTSIESystem S C)
    (dffi : DFFIMeasure S C)
    (dof : DOFMeasure S)
    (hcompat : DFFIDOFCompatible sys dffi dof)
    (c₁ c₂ : C) (hc : c₁ ≤ c₂) :
    dof (sys.accessibility c₂) ≤ dof (sys.accessibility c₁) :=
  hcompat c₁ c₂ hc

end
